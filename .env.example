# GvlPolyMart – copy to .env and fill in values. Do not commit .env.

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App URL used for email redirects and approval links (e.g. https://gvlpolymart.app)
VITE_APP_URL=

# Contact (Contact page + Product detail “Contact Admin”)
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Checkout UPI ID for payment QR
VITE_UPI_ID=

# Optional: Gemini for price predictor in Create Post (leave unset to hide feature)
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=
