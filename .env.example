# GvlPolyMart – copy to .env and fill in values. Do not commit .env.

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App URL used for email redirects and approval links (e.g. https://gvlpolymart.app)
VITE_APP_URL=

# Contact (Contact page + Product detail “Contact Admin”)
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Razorpay checkout key (frontend, safe to expose)
VITE_RAZORPAY_KEY_ID=

# Legacy/manual UPI QR mode (optional, only if you keep old flow)
VITE_UPI_ID=

# Optional: Gemini for price predictor in Create Post (leave unset to hide feature)
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=

# Supabase Edge Function secrets (set in Supabase function env, not in frontend .env):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
